{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch Extension Client",
            "type": "extensionHost",
            "request": "launch",
            "runtimeExecutable": "${execPath}",
            "args": [
                "--extensionDevelopmentPath=${workspaceFolder}/src/extension/debug",
                "${workspaceFolder}/.tmp/",
            ],
        },
        {
            "name": "Launch Language Server",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/.venv/bin/gdoc", // Python CLIのエントリポイント
            "args": [
                "language-server",
                "--socket",
                "6009",
            ],
            "cwd": "${workspaceFolder}/.tmp/",
            "justMyCode": true,
            "console": "integratedTerminal"
        }
    ],
    "compounds": [
        {
            "name": "Debug Client + Server",
            "configurations": [
                "Launch Language Server",
                "Launch Extension Client"
            ]
        }
    ]
}